{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcohol-key-control-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alcohol-key-control-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
